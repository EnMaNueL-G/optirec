<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sombra base de la lente (profundidad) -->
    <path
        android:pathData="M23,56 a31,31 0 1,0 62,0 a31,31 0 1,0 -62,0 Z"
        android:fillColor="#000000"
        android:fillAlpha="0.25" />

    <!-- Aro exterior teal (donut, evenodd) -->
    <path
        android:fillType="evenOdd"
        android:pathData="M23,54 a31,31 0 1,0 62,0 a31,31 0 1,0 -62,0 Z M30,54 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30" android:startY="26"
                android:endX="78" android:endY="82"
                android:startColor="#14C3C3"
                android:endColor="#0B6E6E" />
        </aapt:attr>
    </path>

    <!-- Iris / cristal de la lente -->
    <path android:pathData="M32,54 a22,22 0 1,0 44,0 a22,22 0 1,0 -44,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="47" android:centerY="47"
                android:gradientRadius="30"
                android:startColor="#12A6A6"
                android:endColor="#0B6E6E" />
        </aapt:attr>
    </path>

    <!-- Anillo interior oscuro que enmarca el punto REC -->
    <path
        android:fillType="evenOdd"
        android:pathData="M38,54 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0 Z M42,54 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 Z"
        android:fillColor="#0B6E6E"
        android:fillAlpha="0.55" />

    <!-- Punto REC rojo -->
    <path android:pathData="M43,54 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="50" android:centerY="50"
                android:gradientRadius="15"
                android:startColor="#F35555"
                android:endColor="#E23B3B" />
        </aapt:attr>
    </path>

    <!-- Reflejo/brillo del cristal (arco superior izquierdo) -->
    <path
        android:pathData="M39,42 a19,19 0 0,1 22,-8 a24,24 0 0,0 -28,14 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.16" />

    <!-- Destello puntual sobre el punto REC -->
    <path
        android:pathData="M47,49 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.45" />
</vector>
